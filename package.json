{
  "name": "@mazix/n8n-nodes-converter-documents",
  "version": "1.5.0",
  "description": "n8n community node that extracts text, HTML or Markdown from documents (DOCX, PDF, ODT, ODS, ODP, TXT, MD, PPTX, HTML), named sheets with row objects from spreadsheets (XLSX, CSV), and structured data from JSON, XML and Yandex Market YML, with optional local OCR for scanned PDFs",
  "main": "dist/ConvertFileToJson.node.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.svg"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"const fs=require('fs');fs.cpSync('src/icon.svg','dist/icon.svg');fs.cpSync('src/file-type-loader.js','dist/file-type-loader.js');fs.cpSync('src/ocr/loader.js','dist/ocr/loader.js')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:ocr-smoke": "npm run build && RUN_OCR_SMOKE=1 jest test/integration/ocr-smoke.test.ts --runInBand",
    "test:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "scan:n8n:published": "scan-community-package @mazix/n8n-nodes-converter-documents@$npm_package_version",
    "verify:package": "npm pack --dry-run",
    "dev": "tsc --watch",
    "clean": "rimraf dist coverage",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazixs/n8n-node-converter-documents.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "document-converter",
    "file-converter",
    "pdf",
    "excel",
    "word",
    "powerpoint",
    "csv",
    "xml",
    "yml",
    "yandex-market",
    "html",
    "markdown",
    "docx-to-markdown"
  ],
  "author": {
    "name": "mazix",
    "email": "mazix@bk.ru"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "bugs": {
    "url": "https://github.com/mazixs/n8n-node-converter-documents/issues"
  },
  "homepage": "https://github.com/mazixs/n8n-node-converter-documents#readme",
  "dependencies": {
    "chardet": "^2.2.0",
    "fast-xml-parser": "5.10.1",
    "file-type-modern": "npm:file-type@22.0.1",
    "mammoth": "^1.12.1",
    "node-html-markdown": "^2.0.0",
    "node-html-parser-modern": "npm:node-html-parser@9.0.0",
    "officeparser-modern": "npm:officeparser@6.0.7",
    "papaparse": "^5.6.0",
    "pdfjs-dist": "5.5.207",
    "read-excel-file": "9.3.10",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@n8n/scan-community-package": "0.9.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "n8n-workflow": "^2.30.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/ConvertFileToJson.node.js"
    ]
  },
  "optionalDependencies": {
    "pdf-to-img": "5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
